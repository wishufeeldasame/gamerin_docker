# Copy this file to .env and replace every placeholder. Do not commit .env.
# Values below are for the production server (https://gamerin.live via docker-compose.prod.yml).
# For local http://localhost development, use the values in the `# local:` comments.
# docker compose config fails if a required value (CORS/FRONTEND/JWT/Google OAuth/DB) is empty.

# nginx host port binding (local only).
# docker-compose.prod.yml closes the nginx host port; only Caddy publishes 80/443.
# Use 0.0.0.0 only if other devices on the LAN must reach the local stack.
NGINX_BIND=127.0.0.1
NGINX_PORT=80

# Backend profile / demo seed
# Keep prod,false normally. To seed demo01~demo20 once, set prod,seed and true,
# restart backend, then revert to prod and false and restart again (seeded data is kept).
SPRING_PROFILES_ACTIVE=prod
APP_SEED_ENABLED=false

# Database (DB_NAME/DB_USERNAME/DB_PASSWORD required)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gamerin
DB_USERNAME=gamerin
DB_PASSWORD=change-me-db-password
# Host-side port for local DB access (e.g. Postgres MCP). Bound to 127.0.0.1 only.
# Comment out the postgres service's `ports` entry in docker-compose.yml on real deployments.
DB_HOST_PORT=5432

# Frontend build-time API endpoint.
# Keep this empty to use same-origin relative requests through nginx.
# Changing this value requires rebuilding the frontend image.
NEXT_PUBLIC_API_BASE_URL=

# Backend runtime URLs (required)
# local: CORS_ALLOWED_ORIGINS=http://localhost
# local: FRONTEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=https://gamerin.live
FRONTEND_BASE_URL=https://gamerin.live
FRONTEND_PASSWORD_RESET_PATH=/auth/reset-password

# HTTPS entrypoint (docker-compose.prod.yml only; ignored for local dev)
# Raise HSTS_MAX_AGE step by step: 300 -> 86400 -> 31536000. Hard to undo once long.
SITE_ADDRESS=gamerin.live
HSTS_MAX_AGE=300

# Auth
# JWT_SECRET (required): generate a new one with `openssl rand -base64 48`, locally too.
# The placeholder is shorter than 32 bytes on purpose, so the backend refuses to start with it.
JWT_SECRET=change-me-generate-new-secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600
REFRESH_COOKIE_NAME=refresh_token
# local: REFRESH_COOKIE_SECURE=false (plain http)
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax
STREAM_TOKEN_EXPIRATION_SECONDS=60
STREAM_TOKEN_COOKIE_NAME=message_stream_token
STREAM_TOKEN_COOKIE_SAME_SITE=Lax
# local: STREAM_TOKEN_COOKIE_SECURE=false (plain http)
STREAM_TOKEN_COOKIE_SECURE=true
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Google OAuth (required)
# Redirect URI: https://gamerin.live/login/oauth2/code/google (local: http://localhost/login/oauth2/code/google)
GOOGLE_OAUTH_CLIENT_ID=change-me-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret

# Mail
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=api-key
APP_MAIL_FROM_ADDRESS=no-reply@mail.gamerin.live

# Media
APP_MEDIA_UPLOAD_DIR=/app/uploads
APP_MEDIA_VIDEO_OPTIMIZATION_ENABLED=true
APP_MEDIA_VIDEO_OPTIMIZATION_FFMPEG_PATH=ffmpeg

# Post cleanup
POST_CLEANUP_HARD_DELETE_AFTER=24h
POST_CLEANUP_HIDDEN_HARD_DELETE_AFTER=14d
POST_CLEANUP_INITIAL_DELAY_MS=60000
POST_CLEANUP_FIXED_DELAY_MS=3600000

# OpenAI moderation
# Not required by compose. With moderation enabled and no key, post creation fails with 503.
OPENAI_MODERATION_ENABLED=true
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_API_KEY=change-me-openai-api-key
OPENAI_MODERATION_FFMPEG_PATH=ffmpeg
OPENAI_MODERATION_MAX_PARALLEL_REQUESTS=4
OPENAI_MODERATION_CONNECT_TIMEOUT=3s
OPENAI_MODERATION_READ_TIMEOUT=10s

# PUBG
PUBG_API_KEY=change-me-pubg-api-key
PUBG_API_CONNECT_TIMEOUT=3s
PUBG_API_READ_TIMEOUT=10s

# Riot
RIOT_API_KEY=change-me-riot-api-key
RIOT_API_CONNECT_TIMEOUT=3s
RIOT_API_READ_TIMEOUT=10s

# R6
R6DATA_API_KEY=change-me-r6data-api-key
R6DATA_API_BASE_URL=https://api.r6data.com
R6DATA_API_CONNECT_TIMEOUT=3s
R6DATA_API_READ_TIMEOUT=10s

# KakaoPay
# Secret key(dev) uses CID TC0ONETIME; Secret key(prod) uses the merchant CID.
# Leave empty to disable payments (backend returns 503 for payment ready).
KAKAOPAY_SECRET_KEY=change-me-kakaopay-secret-key
KAKAOPAY_CID=TC0ONETIME
# Payment cancel API (no user-facing screen). Keep false unless refunds are handled manually.
KAKAOPAY_CANCEL_ENABLED=false
